  "provenance": {
    "name": "設計決定：岩堡港（Port-du-Rocher）—— 典故 Fort de Rocher（Wikipedia『Fort de Rocher』：Levasseur、約 1640）",
    "meters_per_voxel": "委託：Tim 2026-10-14「一樣用 0.1m 一格的精度」",
    "palette": "設計決定：RGB332 色盤裡挑；同色在匯出時會合併 ⇒ 每型房屋只用 6–8 色",
    "site.NX": "設計決定：沿岸 128 m（鎮的一條港灣街區，不是整個 Basse-Terre）",
    "site.NY": "設計決定：海 → 山坡 96 m；岩堡放在北邊山坡上（史實：堡在港北邊約 0.5 km 的坡上 —— 縮短成 60 m，好讓鎮跟堡同框）",
    "site.NZ": "設計決定：岩頂 z 240＋小堡 ⇒ 320（32 m）",
    "site.z_sea": "設計決定：z 0 ＝ 海平面下 1 m（不做海床），海面在 z 10",
    "site.quay": "設計決定：石砌碼頭，頂面高出海面 2.2 m",
    "site.piers": "設計決定：兩座木棧橋（電影裡托圖嘉的碼頭是木棧橋＋停泊的船 —— 氛圍，沒逐格對）",
    "site.fort_hill": "史實（Wikipedia『Fort de Rocher』）：堡在港北的山坡、坡上的樹砍光了好看海（約 180° 視野）⇒ 坡上只鋪草不放樹",
    "site.rock": "史實（Wikipedia『Fort de Rocher』）：『a steep rock which stood thirty feet high』⇒ 30 ft ≈ 9.1 m ⇒ 90 格；平面大小是設計決定",
    "site.terraces": "設計決定：鎮裡兩排房子各墊一層平台（坡度約 1:9，一塊地 10 m 深會高低差 1.2 m ⇒ 不墊就得逐棟做石基）；平台之間的街做成坡",
    "site.lots": "設計決定：臨港一排（酒館 B 在大街口、倉庫 C 在西端靠碼頭）＋ 第二排；寬度照房屋外框（含屋簷）排，相鄰屋簷不碰；坡上的小屋與燻肉架之後再放",
    "houses.B": "設計決定：酒館（電影托圖嘉的酒館是片場搭景、沒有名字 ⇒ 店名 Le Cochon Pendu 是 summit 取的；豬 ＝ 電影裡托圖嘉街上的豬＋buccaneer 打野豬的史實）",
    "houses.C": "設計決定：碼頭邊的石砌倉庫（magasin）、吊貨梁；沒有逐件對照史料",
    "houses.D": "設計決定：坡上、巷尾的木板小屋（buccaneer 的營地房）；茅草＝棕櫚葉的意思，色用 thatch",
    "houses.A": "設計決定：法屬安地列斯殖民風（石基、一樓石砌粉刷、二樓木構、木百葉、臨街迴廊）＋電影托圖嘉的樓房與陽台的氛圍；尺寸照一般城鎮連棟樓（6 m 寬、8 m 深）—— 沒有逐件對照史料"
  }
}
